<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.saludador.SaludadorController"
      spacing="16"
      alignment="CENTER">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Sistema Saludador" styleClass="titulo"/>

    <GridPane hgap="12" vgap="12">
        <columnConstraints>
            <ColumnConstraints minWidth="90"/>
            <ColumnConstraints minWidth="220" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nombreField" promptText="Ingresa tu nombre"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Edad:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="edadField" promptText="Ingresa tu edad"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="AM / PM:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="momentoCombo" prefWidth="220" promptText="Selecciona AM o PM"
                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <Button text="Solicitar saludo" defaultButton="true" onAction="#onSolicitarSaludo"/>
    <Label fx:id="mensajeLabel" wrapText="true" styleClass="mensaje"/>
</VBox>
